# This .env stores stores repository wide env variables.
# Anything prefixed with VITE_ is publically accessible to any client.
# Otherwise, variables here are only avaiable in server contexts.

# If adding a variable here, it must also be added in turbo.json "globalEnv" unless it is a NEXT_PUBLIC var.

# Repository wide
VITE_APP_NAME="TrailEyes"
VITE_BACKEND_URL=http://localhost:8000
VITE_PANEL_URL=http://localhost:3000
# Analytics
VITE_POSTHOG_HOST='url'
VITE_POSTHOG_KEY='test'
# Optional
VITE_LOG_LEVEL=info # fatal | error | warn | info | debug | trace
VITE_LOG_FORMAT=json # pretty | json

# apps/panel
VITE_PROTO_API_KEY=PROTO_API_KEY

# apps/backend
BETTER_AUTH_SECRET=SECURE_SEED
STORAGE_DIRECTORY=/var/lib/traileyes

# packages/database
DB_NAME=DATABASE_NAME
DB_HOST=DATABASE_HOST
DB_USER=DATABASE_USER
DB_PASSWORD=DATABASE_PASSWORD
DB_PORT=5432
DB_SSL=true

# packages/email
SMTP_HOST=SMTP_HOST
SMTP_PORT=587
SMTP_USER=SMTP_USER
SMTP_PASS=SMTP_PASS
SMTP_SENDER=sender@domain.tld
SMTP_SENDER_NAME="Sender Name"
